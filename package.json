{
	"name": "front-utua-chat-proxy",
	"description": "Cloudflare Worker proxy for the Utua chat A/B experiment",
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "0.11.1",
		"@eslint/js": "9.39.1",
		"@vitest/runner": "3.2.4",
		"@vitest/snapshot": "3.2.4",
		"eslint": "9.39.2",
		"globals": "16.5.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.48.0",
		"vitest": "3.2.4",
		"wrangler": "4.88.0"
	},
	"private": true,
	"scripts": {
		"build": "tsc --noEmit",
		"cf-typegen": "wrangler types",
		"check": "tsc --noEmit && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"lint": "eslint .",
		"test": "vitest run"
	},
	"type": "module"
}
